# Copy to .env and fill in the real password. .env is git-ignored.
# Supabase → Project Settings → Database → Connection string → Session pooler
SUPABASE_DB_URL=postgresql://postgres.pxuopglqrddsxxbaptss:<YOUR-PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Optional. Without it the briefing falls back to a deterministic template.
GROQ_API_KEY=<your-groq-key>
# gpt-oss-120b reads better; gpt-oss-20b is the cheaper option and works.
GROQ_MODEL=openai/gpt-oss-120b
